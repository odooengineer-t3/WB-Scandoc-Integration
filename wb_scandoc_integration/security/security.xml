<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <!-- Security group that's only activated when ScanDoc auth key is valid -->
        <record id="group_scandoc_authenticated" model="res.groups" forcecreate="True">
            <field name="name">ScanDoc Authenticated Users</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>
    </data>
    
    <data noupdate="1">
        <record id="group_resume_scanner" model="res.groups" forcecreate="False">
            <field name="name">Allow Scandoc Resume Parser</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>
        <record id="group_receipt_scanner" model="res.groups" forcecreate="False">
            <field name="name">Allow Scandoc Delivery Receipt</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>
        <record id="group_po_scanner" model="res.groups" forcecreate="False">
            <field name="name">Allow Scandoc Purchase Order</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>
    </data>
</odoo>
