        <field name="name">ScanDoc Authenticated Users</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_resume_scanner" model="res.groups">
        <field name="name">Allow Scandoc Resume Parser</field>
    </record>

    <record id="group_receipt_scanner" model="res.groups">
        <field name="name">Allow Scandoc Delivery Receipt</field>
    </record>

    <record id="group_po_scanner" model="res.groups">
        <field name="name">Allow Scandoc Purchase Order</field>
    </record>

</odoo>
