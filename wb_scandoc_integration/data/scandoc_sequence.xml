<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Scandoc Manager -->
        <record id="seq_scandoc_manager" model="ir.sequence">
            <field name="name">Scandoc Manager</field>
            <field name="code">scandoc.manager</field>
            <field name="prefix">SDM/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="sequence_crm_lead" model="ir.sequence">
            <field name="name">Lead Code</field>
            <field name="code">crm.lead</field>
            <field eval="4" name="padding"/>
            <field name="prefix">LEAD</field>
    </record>
    </data>
</odoo>
