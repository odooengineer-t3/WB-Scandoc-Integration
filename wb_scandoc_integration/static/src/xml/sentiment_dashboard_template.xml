               <!-- THIRD ROW -->
                <div class="row mt-4">
                    <!-- Communication Style Profiling -->
                    <div class="col-lg-6 mb-4">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body">
                                <h4 class="card-title text-primary mb-3">Communication Style Profiling</h4>
                                <p><strong>Primary Style:</strong>
                                    <span class="badge bg-primary text-light">
                                        <t t-esc="state.communication_style"/>
                                    </span>
                                </p>
                                <h6 class="text-muted mt-3">Areas for Development</h6>
                                <ul class="list-unstyled">
                                    <t t-if="state.areas_for_development and state.areas_for_development !== '—'">
                                        <t t-foreach="state.areas_for_development.split(', ')" t-as="dev" t-key="dev_index">
                                            <li><i class="fa fa-exclamation-triangle text-warning me-2"></i><t t-esc="dev"/></li>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <li><i class="fa fa-check text-success me-2"></i>No significant gaps</li>
                                    </t>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Cultural Fit Indicators -->
                    <div class="col-lg-6 mb-4">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body">
                                <h4 class="card-title text-success mb-3">Cultural Fit Indicators</h4>
                                <p><strong>Cultural Alignment:</strong>
                                    <span class="text-success"><t t-esc="state.cultural_alignment"/></span>
                                    (<t t-esc="state.cultural_fit_score"/>)
                                </p>
                                <h6 class="text-muted mt-3">Collaboration Indicators</h6>
                                <ul class="list-unstyled">
                                    <t t-if="state.collaboration_indicators and state.collaboration_indicators !== '—'">
                                        <t t-foreach="state.collaboration_indicators.split(', ')" t-as="ci" t-key="ci_index">
                                            <li><i class="fa fa-users text-success me-2"></i><t t-esc="ci"/></li>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <li class="text-muted">No Data Found</li>
                                    </t>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECOND LINE of THIRD ROW -->
                <div class="row">
                    <!-- Motivation Analysis -->
                    <div class="col-lg-6 mb-4">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body">
                                <h4 class="card-title text-warning mb-3">Motivation Analysis</h4>
                                <p><strong>Drive:</strong>
                                    <span t-attf-style="color: {{ state.drive_color || '#28a745' }}">
                                        <t t-esc="state.drive_level"/>
                                    </span>
                                    (<t t-esc="state.motivation_score"/>)
                                </p>
                                <!-- <h6 class="text-muted mt-3">Primary Motivators</h6>
                                <p>
                                    <t t-if="state.primary_motivators and state.primary_motivators !== '—'">
                                        <t t-esc="state.primary_motivators"/>
                                    </t>
                                    <t t-else="">—</t>
                                </p> -->
                                  <div class="mt-auto">
                                <h6 class="mb-2">Primary Motivators</h6>
                                <div class="d-flex flex-wrap gap-1">
                                    <t t-if="state.primary_motivators and state.primary_motivators !== '—'">
                                        <t t-foreach="state.primary_motivators.split(', ')" t-as="trait" t-key="trait_index">
                                            <span class="badge bg-secondary" t-esc="trait.trim()"/>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <span class="text-muted small">No Data Found</span>
                                    </t>
                                </div>
                            </div>
                            </div>
                        </div>
                    </div>

                    <!-- Red Flag Detection -->
                    <div class="col-lg-6 mb-4">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body">
                                <h4 class="card-title text-danger mb-3">Red Flag Detection</h4>
                                <p><strong>Risk:</strong>
                                    <span><t t-esc="state.risk_assessment"/></span>
                                </p>

                                <!-- Dynamic Red Flags -->
                                <t t-if="state.red_flags_detected and state.red_flags_detected.trim() !== '' and state.red_flags_detected !== '—'">
                                    <t t-foreach="state.red_flags_detected.split(',')" t-as="flag" t-key="flag_index">
                                        <div class="alert alert-warning p-2 mb-2 d-flex align-items-center">
                                            <i class="fa fa-exclamation-triangle text-dark me-2"></i>
                                            <span><t t-esc="flag.trim()"/></span>
                                        </div>
                                    </t>
                                </t>
                                <t t-else="">
                                    <div class="alert alert-success p-2 d-flex align-items-center">
                                        <i class="fa fa-check text-success me-2"></i>
                                        <strong>No Red Flags Detected:</strong> Resume shows no major warning signs.
                                    </div>
                                </t>

                                <h6 class="text-muted mt-3">Positive Indicators</h6>
                                <ul class="list-unstyled">
                                    <t t-if="state.positive_indicators and state.positive_indicators !== '—'">
                                        <t t-foreach="state.positive_indicators.split(',')" t-as="pi" t-key="pi_index">
                                            <li><i class="fa fa-thumbs-up text-success me-2"></i><t t-esc="pi"/></li>
                                        </t>
                                    </t>
                                    <t t-else=""><li class="text-muted">No Data Found</li></t>
                                </ul>

                                <h6 class="text-muted mt-3">Verification Needed</h6>
                                <ul class="list-unstyled mb-0">
                                    <li>Confirm project outcomes and metrics</li>
                                    <li>Validate leadership experience claims</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            <!-- </t> -->
            <!-- END t-else -->
        </div>
    </t>
</templates>