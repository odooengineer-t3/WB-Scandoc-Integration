            <!-- <t t-else=""> -->
<h1 class="text-center">Resume Analysis Complete</h1>
<h5 class="text-center text-muted">Comprehensive sentiment and behavioral analysis</h5>

<div class="row mt-5 g-4 align-items-stretch resume-analysis-cards">
    <!-- LEFT CARD -->
    <div class="col-lg-6 h-100">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h3 class="card-title text-info mb-4">
                    Sentiment &amp; Behavioral Intelligence
                </h3>

                <div class="position-relative d-inline-block mx-auto mb-4">
                    <svg class="circular-chart" width="160" height="160" viewBox="0 0 160 160">
                        <circle class="bg-circle" cx="80" cy="80" r="70" fill="none" stroke="#e9ecef" stroke-width="12"/>
                        <circle class="progress-circle" cx="80" cy="80" r="70" fill="none" stroke="#28a745" stroke-width="12"
                                stroke-linecap="round"
                                t-attf-stroke-dasharray="{{ 2 * 3.1416 * 70 }}, {{ 2 * 3.1416 * 70 }}"
                                t-attf-stroke-dashoffset="{{ (1 - state.sentiment_score/100) * 2 * 3.1416 * 70 }}"/>
                    </svg>
                    <div class="position-absolute top-50 start-50 translate-middle text-center w-100">
                        <div class="fs-3 fw-bold text-success" t-esc="state.sentiment_score"/>
                        <div class="small text-muted">Sentiment Score</div>
                    </div>
                </div>

                <div class="row g-2 small mb-3 flex-grow-1">
                    <div class="col-6"><strong>Emotional Tone:</strong></div>
                    <div class="col-6" t-esc="state.emotional_tone"/>

                    <div class="col-6"><strong>Communication Style:</strong></div>
                    <div class="col-6">
                        <span class="badge bg-info text-dark" t-esc="state.communication_style"/>
                    </div>

                    <div class="col-6"><strong>Cultural Fit:</strong></div>
                    <div class="col-6">
                        <t t-esc="state.cultural_alignment"/> <t t-esc="state.cultural_fit_score"/>
                    </div>

                    <div class="col-6"><strong>Risk:</strong></div>
                    <div class="col-6">
                        <span t-attf-class="badge {{ state.risk_assessment == 'Low Risk' ? 'bg-success' : 'bg-warning' }}">
                            <t t-esc="state.risk_assessment"/>
                        </span>
                    </div>

                    <div class="col-6"><strong>Hire Recommendation:</strong></div>
                    <div class="col-6"><strong t-esc="state.hire_recommendation_score"/></div>
                </div>

                <p class="text-muted small mb-3">
                    The language demonstrates enthusiasm for growth and collaboration.
                </p>

                <!-- FIXED: Added t-key -->
                <div class="mt-auto">
                    <h6 class="mb-2">Key Personality Traits</h6>
                    <div class="d-flex flex-wrap gap-1">
                        <t t-if="state.personality_traits and state.personality_traits != '—'">
                            <t t-foreach="state.personality_traits.split(', ')" t-as="trait" t-key="trait_index">
                                <span class="badge bg-secondary" t-esc="trait.trim()"/>
                            </t>
                        </t>
                        <t t-else="">
                            <span class="text-muted small">No Data Found</span>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT CARD -->
    <div class="col-lg-6" style="height:510px;">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex flex-column">
                <h3 class="card-title text-success mb-4">
                    Confidence Level Analysis
                </h3>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <strong>Overall Confidence:</strong>
                    <span class="badge bg-warning text-dark" t-esc="state.confidence_score"/>
                </div>

                <!-- FIXED: Added t-key -->
               <h6 class="text-muted mb-2">Confidence Indicators</h6>
                <ul class="list-unstyled small mb-3">
                    <t t-if="state.confidence_indicators and state.confidence_indicators != '—'">
                        <t t-foreach="state.confidence_indicators.split(',')" t-as="indicator" t-key="indicator">
                            <t t-if="indicator.trim()">
                                <li class="text-success">
                                    <i class="fa fa-check me-1"></i>
                                    <t t-esc="indicator.trim()"/>
                                </li>
                            </t>
                        </t>
                    </t>
                    <t t-else="">
                        <li class="text-muted"><i class="fa fa-minus me-1"></i>No Data Found</li>
                    </t>
                </ul>

                <!-- FIXED: Added t-key -->
                <h6 class="text-muted mb-2">Areas for Improvement</h6>
                <ul class="list-unstyled small">
                    <t t-if="state.areas_for_improvement and state.areas_for_improvement != '—'">
                        <t t-foreach="state.areas_for_improvement.split('\n')" t-as="improvement" t-key="improvement_index">
                            <li class="text-warning"><i class="fa fa-exclamation-triangle me-1"></i> <t t-esc="improvement.trim()"/></li>
                        </t>
                    </t>
                    <t t-else="">
                        <li class="text-muted"><i class="fa fa-minus me-1"></i>No Data Found</li>
                    </t>
                </ul>
            </div>
        </div>
    </div>
</div>


