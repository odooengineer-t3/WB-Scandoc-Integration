<odoo>
    <record id="action_vendor_parser_wizard" model="ir.actions.act_window">
        <field name="name">Vendor Bill Scan</field>
        <field name="res_model">resume.parser.wizard</field>
        <field name="view_mode">form</field>
        <field name="context">{'default_doc_type': 'VendorBill', 'readonly_doc_type': True}</field>
        <field name="target">new</field>
    </record>

    <record id="crm_lead_view_form_inherit_wb" model="ir.ui.view">
        <field name="name">crm.lead.form</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="lead_code" class="oe_inline" />
                <label for="lead_code" string="  " class="oe_inline" />
            </field>
            <field name="referred" position="after">
                <field name="doc_id"/>
            </field>
        </field>
    </record>

    <menuitem
        id="menu_resume_parser_wizard"
        name="Vendor Bill Scan"
        parent="purchase.menu_procurement_management"
        groups="wb_scandoc_integration.group_po_scanner"
        action="wb_scandoc_integration.action_vendor_parser_wizard"
        sequence="100"
    />
    <menuitem id="menu_delivery_challan_scan" name="Delivery Challan Scan"
              parent="purchase.menu_purchase_root"
              groups="wb_scandoc_integration.group_receipt_scanner"
              action="wb_scandoc_integration.action_deliver_parser_wizard"
              sequence="110"/>
</odoo>
