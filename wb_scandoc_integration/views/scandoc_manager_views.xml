<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <!-- ======================= -->
        <!--        List View        -->
        <!-- ======================= -->
        <record id="view_scandoc_manager_list" model="ir.ui.view">
            <field name="name">scandoc.manager.list</field>
            <field name="model">scandoc.manager</field>
            <field name="arch" type="xml">
                <tree string="Scandoc Manager" create="false" decoration-danger="remaining_credit &lt; 1" duplicate="false" default_order="id desc">
                    <field name="name"/>
                    <field name="purchased_credit"/>
                    <field name="used_credit"/>
                    <field name="remaining_credit" sum="Total Scan Credit"/>
                    <field name="active" column_invisible="1"/>
                </tree>
            </field>
        </record>

        <!-- ======================= -->
        <!--        Form View        -->
        <!-- ======================= -->
        <record id="view_scandoc_manager_form" model="ir.ui.view">
            <field name="name">scandoc.manager.form</field>
            <field name="model">scandoc.manager</field>
            <field name="arch" type="xml">
                <form duplicate="false" create="false" string="Scandoc Manager">
                    <sheet>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Credits">
                            <group>
                                <field name="purchased_credit"/>
                            </group>
                            <group>
                                <field name="remaining_credit" readonly="1"/>
                                <field name="used_credit" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ======================= -->
        <!--       Search View       -->
        <!-- ======================= -->
        <record id="view_scandoc_manager_search" model="ir.ui.view">
            <field name="name">scandoc.manager.search</field>
            <field name="model">scandoc.manager</field>
            <field name="arch" type="xml">
                <search string="Scandoc Manager">
                    <field name="name"/>
                    <field name="active"/>
                    <filter name="Archived" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record model='ir.actions.act_url' id='action_purchase_scandoc_credit'>
            <field name='name'>Purchase Credit</field>
            <field name='url'>http://portal.scandoc.xyz/</field>
            <field name="binding_model_id" eval="False"/>
        </record>
    </data>
</odoo>
